#!/usr/bin/env python3
"""Refuse a tool call whose raw text carries one of this role's words. No parsing, no network."""
import argparse
import json
from pathlib import Path
import sys
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from hard_edges import settings_for, tool_decision


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--role', choices=['orchestrator', 'worker', 'reviewer'], default='orchestrator')
    args = parser.parse_args()
    event = json.load(sys.stdin)
    role = args.role
    # Native subagent frontmatter also pins its own worker hook; this handles inherited global hooks.
    if role == 'orchestrator' and event.get('agent_type') in ('worker', 'devstandard:worker', 'reviewer', 'devstandard:reviewer'):
        role = event['agent_type'].split(':')[-1]
    # The policy comes from the local `origin/main` ref and never raises: an unreadable
    # policy is the built-in defaults, so no network fault can turn into a refusal (#323).
    settings = settings_for(event.get('cwd') or '.')
    reason = tool_decision(role, event['tool_name'], event['tool_input'], settings)
    if reason:
        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny', 'permissionDecisionReason': reason}}))
    else:
        print('{}')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        # A malformed event or a broken guard denies; nothing here reads the network.
        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny', 'permissionDecisionReason': f'guard refused: {error}'}}))
