#!/usr/bin/env python3
"""Refuse a tool call whose raw text carries one of this role's words.

No parsing, no network, and nothing to configure: the word lists are in `hard_edges.py`
and this hook reads its event and the dispatcher-supplied role.
"""
import argparse
import json
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from hard_edges import tool_decision


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--role', choices=['orchestrator', 'worker', 'reviewer'], default='orchestrator')
    args = parser.parse_args()
    event = json.load(sys.stdin)
    role = args.role
    if role == 'orchestrator' and os.environ.get('DEVSTANDARD_ROLE') in ('worker', 'reviewer'):
        role = os.environ['DEVSTANDARD_ROLE']
    # Native subagent frontmatter also pins its own worker hook; this handles inherited global hooks.
    if role == 'orchestrator' and event.get('agent_type') in ('worker', 'devstandard:worker', 'reviewer', 'devstandard:reviewer'):
        role = event['agent_type'].split(':')[-1]
    tool, arguments = event['tool_name'], event['tool_input']
    if not isinstance(tool, str) or not tool:
        raise ValueError('tool_name must be a nonempty string')
    if tool in ('Bash', 'exec_command'):
        if not isinstance(arguments, dict):
            raise ValueError('shell tool_input must be an object')
        command = arguments.get('command', arguments.get('cmd'))
        if not isinstance(command, str):
            raise ValueError('shell command must be a string')
    reason = tool_decision(role, tool, arguments)
    if reason:
        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny', 'permissionDecisionReason': reason}}))
    else:
        print('{}')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        # A malformed event or a broken guard denies; nothing here reads a file or the network.
        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny', 'permissionDecisionReason': f'guard refused: {error}'}}))
