#!/usr/bin/env python3
"""Deny recognized role/irreversible operations before a supported local tool executes."""
import argparse
import json
from pathlib import Path
import re
import sys
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from hard_edges import authorized, classify, command_segments, founding_setup, run, settings_for, simple_argv, tool_decision


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--role', choices=['orchestrator', 'worker', 'reviewer'], default='orchestrator')
    args = parser.parse_args()
    event = json.load(sys.stdin)
    role = args.role
    # Native subagent frontmatter also pins its own worker hook; this handles inherited global hooks.
    if role == 'orchestrator' and event.get('agent_type') in ('worker', 'devstandard:worker', 'reviewer', 'devstandard:reviewer'):
        role = event['agent_type'].split(':')[-1]
    tool, arguments = event['tool_name'], event['tool_input']
    repo, settings = None, {}
    reason = tool_decision(role, tool, arguments, settings)
    shell = tool in ('Bash', 'exec_command')
    command = arguments.get('command', arguments.get('cmd', '')) if shell else ''
    # Workers/reviewers refuse unsupported syntax without a policy read. Other calls share
    # the same remote default-branch snapshot, cached by settings_for per process.
    if role == 'orchestrator' or not shell or classify(command, settings) != 'unparsed':
        project = event['cwd']
        repo, settings = settings_for(project)
        reason = tool_decision(role, tool, arguments, settings)
        if repo is None and shell and classify(command, settings, role) in ('merge', 'release', 'irreversible'):
            reason = 'no repository to read policy from'
    if repo is not None and role == 'orchestrator' and shell and classify(command, settings, role) != 'unparsed':
        words = simple_argv(command)
        # Only the exact installed entry point can perform a guarded merge. No shell composition.
        if words[:2] == [str(ROOT / 'scripts/guard'), 'merge'] and not any(c in command for c in ';|&`$\n<>'):
            reason = None
        else:
            kind = classify(command, settings, role)
            words = [word for segment in command_segments(command, role)
                     for word in segment if isinstance(word, str)]
            if kind == 'release' and any(re.search(r'\bv[1-9][0-9]*\.0\.0\b', word) for word in words):
                kind = 'major-release'
            # The founding push is decided before any local HEAD read: a repository being
            # founded may have none, and no authorization record can exist before its policy.
            if kind == 'irreversible' and founding_setup(repo, command, settings):
                reason = None
            elif kind in ('release', 'major-release', 'irreversible'):
                head = run('git', '-C', project, 'rev-parse', 'HEAD')
                if authorized(repo, head, command, kind, settings):
                    reason = None
    if reason:
        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny', 'permissionDecisionReason': reason}}))
    else:
        print('{}')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        # Input, policy, API and parsing failures all deny; no warning-only fall-through.
        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny', 'permissionDecisionReason': f'guard refused: {error}'}}))
