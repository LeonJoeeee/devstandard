#!/usr/bin/env bash
# codex-adopt — adopt or unadopt DevStandard's Codex worker-role delivery in the current repo.
#
# Usage (run at the consuming repo's ROOT):
#   codex-adopt adopt              # marker + gitignore entry
#   codex-adopt adopt --fallback   # marker + gitignore entry + managed AGENTS.md block
#   codex-adopt unadopt            # remove what adopt recorded it created
#
# Adoption is a COMMITTED change: the managed artifacts are tracked files, the resulting diff is
# reviewed and merged like any change, and git itself is the provenance and undo mechanism (ADR
# 0038). This script promises idempotence and refuse-on-unexpected — never byte-perfect inverse
# restoration. Every refusal exits 1 with zero mutation.
#
# Managed artifacts:
#   .devstandard      — the opt-in marker; also the ownership manifest (grammar below).
#   .gitignore        — the exact line `/.claude/worktrees/` (worker worktrees must be ignored:
#                       reference/worktree-lifecycle.md Birth step 3).
#   AGENTS.md         — only under --fallback: a managed, delimited, PREPENDED block delivering the
#                       worker role where hooks are unavailable.
#
# Marker grammar (exact):
#   devstandard-adopted
#   gitignore-entry: added|preexisting
#   fallback-block: added|none|refused-override

set -euo pipefail
unset GIT_DIR GIT_WORK_TREE 2>/dev/null || true

MODE="${1-}"
FALLBACK=0
[ "${2-}" = "--fallback" ] && FALLBACK=1
case "$MODE" in adopt|unadopt) ;; *) echo "usage: codex-adopt adopt [--fallback] | unadopt" >&2; exit 1;; esac

# ---- target resolution: the repo containing cwd; refuse anything unvalidatable ----
if ! TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || [ -z "$TOP" ]; then
    echo "codex-adopt: not inside a git worktree (bare repos and non-repos are refused)" >&2; exit 1
fi
cd "$TOP"

MARKER=".devstandard"
IGNORE_FILE=".gitignore"
IGNORE_LINE="/.claude/worktrees/"
AGENTS="AGENTS.md"
BLOCK_BEGIN="<!-- devstandard-codex-fallback:begin (managed by scripts/codex-adopt) -->"
BLOCK_END="<!-- devstandard-codex-fallback:end -->"
LEGACY_MARK="<!-- devstandard-pointer (managed by reference/harness-codex.md) -->"

refuse() { echo "codex-adopt: REFUSED (no mutation): $*" >&2; exit 1; }

# non-regular / symlink checks on every file we may touch
for f in "$MARKER" "$IGNORE_FILE" "$AGENTS"; do
    if [ -e "$f" ] || [ -L "$f" ]; then
        [ -L "$f" ] && refuse "$f is a symlink"
        [ -f "$f" ] || refuse "$f exists but is not a regular file"
    fi
done

# atomic single-file write
write_file() { # $1=path, stdin=content
    local tmp; tmp="$(mktemp "${1}.XXXXXX")"
    cat > "$tmp"; mv "$tmp" "$1"
}

# ---- read current marker state ----
MARKER_STATE="absent"   # absent | valid | invalid
GI_REC=""; FB_REC=""
if [ -f "$MARKER" ]; then
    if [ "$(head -1 "$MARKER" 2>/dev/null)" = "devstandard-adopted" ]; then
        GI_REC="$(sed -n 's/^gitignore-entry: \(added\|preexisting\)$/\1/p' "$MARKER")"
        FB_REC="$(sed -n 's/^fallback-block: \(added\|none\|refused-override\)$/\1/p' "$MARKER")"
        if [ -n "$GI_REC" ] && [ -n "$FB_REC" ] && [ "$(wc -l < "$MARKER")" -le 3 ]; then
            MARKER_STATE="valid"
        else
            MARKER_STATE="invalid"
        fi
    else
        MARKER_STATE="invalid"
    fi
fi

has_ignore_line() { [ -f "$IGNORE_FILE" ] && grep -qxF "$IGNORE_LINE" "$IGNORE_FILE"; }
count_begin() { if [ -f "$AGENTS" ]; then grep -cxF "$BLOCK_BEGIN" "$AGENTS" || true; else echo 0; fi; }
count_end()   { if [ -f "$AGENTS" ]; then grep -cxF "$BLOCK_END" "$AGENTS" || true; else echo 0; fi; }
has_legacy()  { [ -f "$AGENTS" ] && grep -qxF "$LEGACY_MARK" "$AGENTS"; }

fallback_block_text() {
    cat <<EOF
$BLOCK_BEGIN
DEVSTANDARD-CODEX-ROLE-V1 (fallback delivery — the session hook was unavailable when this repo
adopted). On this project the MAIN SESSION is a Claude Code session; a Codex session is an
EXECUTOR: never merge, tag, or release — even when directly asked; decisions and evidence count
only on the GitHub issue or PR. Before acting on this repository, read IN FULL the installed
DevStandard plugin's reference/harness-codex.md (locate it with:
codex plugin list --json | look up devstandard's source.path) — it defines your role paths and
the worktree rules.
$BLOCK_END
EOF
}

write_marker() { # $1=gitignore record, $2=fallback record
    printf 'devstandard-adopted\ngitignore-entry: %s\nfallback-block: %s\n' "$1" "$2" | write_file "$MARKER"
}

# duplicate/malformed delimiter check (applies whenever AGENTS.md exists)
NB="$(count_begin)"; NE="$(count_end)"
if [ "$NB" != "$NE" ] || [ "$NB" -gt 1 ]; then
    refuse "AGENTS.md managed-block delimiters malformed (begin=$NB end=$NE)"
fi

if [ "$MODE" = "adopt" ]; then
    [ "$MARKER_STATE" = "invalid" ] && refuse ".devstandard exists but is not a marker this tool manages"

    # -- gitignore entry --
    if [ "$MARKER_STATE" = "valid" ]; then
        GI_NEW="$GI_REC"
        if [ "$GI_REC" = "added" ] && ! has_ignore_line; then refuse "marker records gitignore-entry: added but the line is missing"; fi
    elif has_ignore_line; then
        GI_NEW="preexisting"; echo "gitignore entry: preexisting (left alone)"
    else
        { if [ -f "$IGNORE_FILE" ]; then cat "$IGNORE_FILE"; fi; printf '%s\n' "$IGNORE_LINE"; } | write_file "$IGNORE_FILE"
        GI_NEW="added"; echo "gitignore entry: added"
    fi

    # -- fallback block --
    FB_NEW="${FB_REC:-none}"
    if has_legacy; then
        # canonical legacy block: LEGACY_MARK line through the exact closing sentence line
        if grep -qxF "Do not answer until you have read it." "$AGENTS"; then
            python3 - "$AGENTS" "$BLOCK_BEGIN" "$BLOCK_END" "$LEGACY_MARK" <<'PY'
import sys
path, b, e, legacy = sys.argv[1:5]
lines = open(path).read().split("\n")
try:
    i = lines.index(legacy)
    j = lines.index("Do not answer until you have read it.", i)
except ValueError:
    sys.exit(3)
new = lines[:i] + [b] + lines[i+1:j+1] + [e] + lines[j+1:]
import tempfile, os
fd, tmp = tempfile.mkstemp(dir=".", prefix=path + "."); os.write(fd, "\n".join(new).encode()); os.close(fd)
os.replace(tmp, path)
PY
            rc=$?; [ "$rc" = 0 ] || refuse "legacy AGENTS.md block does not match the canonical grammar"
            FB_NEW="added"; echo "legacy fallback block: migrated to paired delimiters"
            NB="$(count_begin)"; NE="$(count_end)"   # migration rewrote AGENTS.md — stale counts would double-add
        else
            refuse "legacy AGENTS.md marker present but the canonical closing line is missing"
        fi
    fi
    if [ "$FALLBACK" = 1 ] && [ "$NB" = 0 ] && ! has_legacy; then
        if [ -f "AGENTS.override.md" ]; then
            FB_NEW="refused-override"; echo "fallback block: refused (AGENTS.override.md shadows AGENTS.md)"
        else
            { fallback_block_text; if [ -f "$AGENTS" ]; then cat "$AGENTS"; fi; } | write_file "$AGENTS"
            FB_NEW="added"; echo "fallback block: added (prepended)"
        fi
    elif [ "$FALLBACK" = 1 ] && [ "$NB" = 1 ]; then
        FB_NEW="added"; echo "fallback block: already present"
    fi

    if [ "$MARKER_STATE" = "valid" ] && [ "$GI_NEW" = "$GI_REC" ] && [ "$FB_NEW" = "$FB_REC" ]; then
        echo "already adopted"
    else
        write_marker "$GI_NEW" "$FB_NEW"; echo "marker: written (gitignore-entry: $GI_NEW, fallback-block: $FB_NEW)"
    fi
    exit 0
fi

# ---- unadopt ----
if [ "$MARKER_STATE" = "absent" ]; then echo "not adopted"; exit 0; fi
[ "$MARKER_STATE" = "invalid" ] && refuse ".devstandard exists but is not a marker this tool manages"

# recorded-vs-actual consistency BEFORE any mutation
if [ "$GI_REC" = "added" ] && ! has_ignore_line; then refuse "recorded gitignore-entry: added but the line is missing"; fi
if [ "$FB_REC" = "added" ] && [ "$NB" != 1 ]; then refuse "recorded fallback-block: added but the managed block is missing or malformed"; fi

if [ "$GI_REC" = "added" ]; then
    grep -vxF "$IGNORE_LINE" "$IGNORE_FILE" | write_file "$IGNORE_FILE" || true
    [ -s "$IGNORE_FILE" ] || rm -f "$IGNORE_FILE"
    echo "gitignore entry: removed"
else
    echo "gitignore entry: preexisting (preserved)"
fi
if [ "$FB_REC" = "added" ]; then
    python3 - "$AGENTS" "$BLOCK_BEGIN" "$BLOCK_END" <<'PY'
import sys, os, tempfile
path, b, e = sys.argv[1:4]
lines = open(path).read().split("\n")
i = lines.index(b); j = lines.index(e, i)
new = lines[:i] + lines[j+1:]
fd, tmp = tempfile.mkstemp(dir=".", prefix=path + "."); os.write(fd, "\n".join(new).encode()); os.close(fd)
os.replace(tmp, path)
PY
    # remove AGENTS.md entirely if the block was its only content
    if [ -f "$AGENTS" ] && ! grep -q '[^[:space:]]' "$AGENTS"; then rm -f "$AGENTS"; fi
    echo "fallback block: removed"
fi
rm -f "$MARKER"; echo "marker: removed"
exit 0
