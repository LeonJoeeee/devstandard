#!/usr/bin/env python3
"""Dispatch one DevStandard lane. Requires Python 3.9+, git, gh, and Linux setsid/nohup."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
import review_packet

ROOT = Path(__file__).resolve().parents[1]
MARKER = '<!-- devstandard-dispatch-v1 -->'


class Refusal(Exception):
    pass


def require(condition, message):
    if not condition:
        raise Refusal(message)


def run(*args, cwd=None):
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    require(result.returncode == 0, f'{shlex.join(map(str, args))}: {result.stderr.strip()}')
    return result.stdout.strip()


def git(project, *args):
    return run('git', '-C', str(project), *args)


def filled(value, name):
    require(value and value.strip(), f'missing {name}')
    require(not re.search(r'\{[A-Z_][A-Z_0-9]*\}|\{field\}|\b(?:TBD|TODO)\b', value),
            f'unresolved placeholder in {name}')
    return value.strip()


def contract(body):
    # Heading sections are the issue contract; fenced examples and comments are not fields.
    body = re.sub(r'<!--.*?-->', '', body, flags=re.S)
    body = re.sub(r'^(```|~~~).*?^\1[^\n]*$', '', body, flags=re.M | re.S)
    sections = {}
    matches = list(re.finditer(r'^#{1,6}\s+([^\n]+?)\s*#*\s*$', body, re.M))
    for i, match in enumerate(matches):
        name = match.group(1).lower()
        if name in ('goal', 'bounds', 'done-check'):
            require(name not in sections, f'duplicate {name} section')
            sections[name] = body[match.end():matches[i+1].start() if i+1 < len(matches) else len(body)]
    return {key: filled(sections.get(key), key) for key in ('goal', 'bounds', 'done-check')}


def standing():
    page = (ROOT / 'reference/external-agent.md').read_text()
    records = re.findall(r'The standing setting on these projects is `([^`]+)`', page)
    require(len(records) == 1, 'standing setting must occur exactly once')
    match = re.fullmatch(r'-m ([^\s`-][^\s`]*) -c model_reasoning_effort=([^\s`-][^\s`]*)', records[0])
    require(match, 'invalid standing model/effort setting')
    return match.groups()


def reviewer_role(value, identity):
    structured = review_packet.decode(value)
    require(structured is not None, 'reviewer requires structured contract slots; use scripts/review-packet assemble')
    return review_packet.render(structured, identity)


def pinned_evidence(project, packet):
    structured = review_packet.decode(packet)
    require(structured is not None, 'reviewer requires structured contract slots')
    slots = review_packet.validate(structured, "selected by dispatcher")
    base, head, convention = (slots[key] for key in ('REVIEW_BASE_SHA', 'HEAD_SHA', 'CONVENTION_BASE_SHA'))
    for name, sha, kind in [('review base', base, 'tree'), ('head', head, 'commit'),
                            ('convention base', convention, 'tree')]:
        require(re.fullmatch(r'(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})', sha), f'{name} must be a full SHA')
        git(project, 'rev-parse', '--verify', f'{sha}^{{{kind}}}')
    evidence = []

    def capture(*args, absent=False):
        command = ['git', '-C', str(project), *args]
        result = subprocess.run(command, text=True, capture_output=True)
        require(result.returncode == 0 or absent,
                f'{shlex.join(command)}: {result.stderr.strip()}')
        evidence.append(dict(command=shlex.join(command), exit_code=result.returncode,
                             stdout=chunks(result.stdout), stderr=chunks(result.stderr)))

    def chunks(text):
        return [line[i:i+1000] for line in text.splitlines(keepends=True)
                for i in range(0, len(line), 1000)]

    for options in [('--name-status',), ('--stat',), ()]:
        capture('diff', '--no-ext-diff', '--no-textconv', '--no-color', *options, base, head)
    # Include both sides of renames and all extensions: documentation is semantic, not a suffix.
    paths = git(project, 'diff', '--name-status', '--no-renames', '-z', base, head).split('\0')[1::2]
    for path in filter(None, paths):
        absent = not git(project, 'ls-tree', '-z', convention, '--', ':(literal)' + path)
        # A new path legitimately has no base blob; retain git show's failure as evidence of absence.
        capture('show', f'{convention}:{path}', absent=absent)
    return '\n\n## Pinned Git evidence\n' + json.dumps(evidence, ensure_ascii=False, indent=2) + '\n'


def records(comments):
    result = []
    for comment in comments:
        body = comment['body']
        if body.startswith(MARKER):
            match = re.search(r'```json\n(.*?)\n```', body, re.S)
            require(match, 'malformed dispatcher lane record on issue')
            result.append(json.loads(match.group(1)))
    return result


def publish(project, repo, issue, record, scratch):
    path = scratch / 'comment.md'
    path.write_text(MARKER + '\nDispatcher lane observation (process exit is not task acceptance).\n```json\n'
                    + json.dumps(record, indent=2) + '\n```\n')
    return run('gh', 'issue', 'comment', str(issue), '--repo', repo, '--body-file', str(path), cwd=project)


def alive(record):
    if record.get('completion') and Path(record['completion']).exists():
        return False
    if record.get('status') == 'awaiting-agent-tool':
        return True  # Only the native caller can attest that its handle has finished.
    pid = record.get('pid')
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def lane_check(project, lane):
    wt = Path(lane['worktree'])
    require(wt.is_dir(), 'recorded worktree is missing')
    require(Path(git(wt, 'rev-parse', '--show-toplevel')).resolve() == wt, 'worktree root mismatch')
    require(git(wt, 'branch', '--show-current') == lane['branch'], 'recorded branch mismatch')
    common = Path(git(wt, 'rev-parse', '--path-format=absolute', '--git-common-dir'))
    require(common == Path(git(project, 'rev-parse', '--path-format=absolute', '--git-common-dir')),
            'recorded lane belongs to another repository')
    require(git(wt, 'rev-parse', '--git-dir') != git(wt, 'rev-parse', '--git-common-dir'),
            'recorded lane is not a linked worktree')


def supervisor(scratch):
    """Foreground Codex in a detached session; a publication gate prevents unrecorded launches."""
    scratch = Path(scratch)
    code = 125
    try:
        deadline = time.monotonic() + 60
        while not (scratch / 'launch').exists():
            if time.monotonic() >= deadline:
                raise Refusal('lane publication did not complete; executor was not launched')
            time.sleep(.05)
        command = json.loads((scratch / 'command.json').read_text())
        with open(os.devnull) as stdin:
            code = subprocess.run(command, stdin=stdin).returncode
    except Exception as error:
        print(f'dispatch supervisor: {error}', flush=True)
    finally:
        tmp = scratch / 'exit-code.tmp'
        tmp.write_text(str(code) + '\n')
        tmp.replace(scratch / 'exit-code')
    return code


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('issue', type=int)
    parser.add_argument('--purpose', choices=['worker', 'reviewer'])
    parser.add_argument('--implementation', choices=['codex', 'claude'])
    parser.add_argument('--project', type=Path, default=Path.cwd(), help='target checkout, distinct from plugin installation')
    parser.add_argument('--base', help='required named ref for a new lane, normally origin/main; fetch first')
    parser.add_argument('--branch', help='default task/ISSUE-TITLE; existing branch requires --adopt')
    parser.add_argument('--worktree', type=Path, help='default PROJECT/.claude/worktrees/ISSUE-TITLE')
    parser.add_argument('--packet', type=Path, help='complete caller-assembled reviewer contract and packet')
    parser.add_argument('--brief', type=Path, help='worker inputs/output detail or required continuation brief')
    parser.add_argument('--continue', dest='continuing', action='store_true')
    parser.add_argument('--adopt', action='store_true', help='record an existing --branch and --worktree with --base; does not launch')
    parser.add_argument('--pr', type=int, help='existing lane PR (required for delivered continuation and merged cleanup)')
    parser.add_argument('--resume', help='Claude worker Agent handle to resume; reviewers are always fresh')
    parser.add_argument('--native-finished', action='store_true',
                        help='caller attests ALL outstanding Claude handles in this lane finished; bypasses their liveness checks for this operation only')
    parser.add_argument('--cleanup', action='store_true')
    parser.add_argument('--discard', action='store_true', help='explicit caller instruction to discard this lane instead of merge')
    parser.add_argument('--force-delete', action='store_true', help='caller authorizes -D after reviewing printed inventory')
    args = parser.parse_args()
    require(args.issue > 0, 'issue must be positive')
    project = args.project.resolve()
    require(Path(git(project, 'rev-parse', '--show-toplevel')).resolve() == project, '--project must be a checkout root')
    repo = run('gh', 'repo', 'view', '--json', 'nameWithOwner', '--jq', '.nameWithOwner', cwd=project)
    issue = json.loads(run('gh', 'issue', 'view', str(args.issue), '--repo', repo,
                           '--json', 'number,title,url,body,state,comments', cwd=project))
    # Reviewer evidence retains fenced commands and nested sections verbatim.
    fields = (review_packet.issue_contract if args.purpose == 'reviewer' else contract)(issue['body'])
    # No files, branches, comments, or processes before this gate.
    history = records(issue['comments'])
    lanes = [r for r in history if r.get('kind') == 'lane']
    lane = lanes[-1] if lanes else None
    existing = args.cleanup or args.continuing or args.purpose == 'reviewer'
    require(args.cleanup or args.adopt or args.purpose, '--purpose is required')
    require(not args.adopt or not any((args.cleanup, args.continuing, args.purpose, args.implementation,
                                      args.packet, args.brief, args.resume, args.native_finished)),
            '--adopt records only; run dispatch, continuation, or cleanup separately')
    require(not args.packet or args.purpose == 'reviewer', '--packet is for reviewers; workers use --brief')
    require(not args.discard or args.cleanup, '--discard requires --cleanup')
    require(not args.force_delete or args.cleanup, '--force-delete requires --cleanup')
    require(not args.resume or (args.continuing and args.purpose == 'worker'), '--resume is for continuing Claude workers only')
    if existing:
        require(lane, 'no recorded lane; dispatch a worker or --adopt an existing lane first')
        require(not any(r.get('status') == 'cleaned' and r.get('lane_id') == lane['lane_id'] for r in history), 'lane already cleaned')
        for key, value in [('branch', args.branch), ('worktree', str(args.worktree.resolve()) if args.worktree else None), ('base', args.base)]:
            require(value is None or value == lane[key], f'{key} differs from recorded lane')
        lane_check(project, lane)
        runs = [r for r in history if r.get('kind') == 'run' and r.get('lane_id') == lane['lane_id']]
        for previous in runs:
            if previous.get('implementation') == 'claude' and args.native_finished:
                continue
            require(not alive(previous), 'recorded executor still running; wait for completion (Claude: --native-finished)')
    else:
        require(not lane or any(r.get('status') == 'cleaned' and r.get('lane_id') == lane['lane_id'] for r in history),
                'lane exists; use --continue')
        base = filled(args.base, 'base')
        require(base != 'HEAD' and not base.startswith('-') and not re.fullmatch(r'[0-9a-fA-F]{40,64}', base), 'base must be a named ref')
        require(git(project, 'rev-parse', '--symbolic-full-name', base).startswith('refs/'), 'base must be a named ref')
        base_sha = git(project, 'rev-parse', '--verify', base + '^{commit}')
        slug = re.sub('[^a-z0-9]+', '-', issue['title'].lower()).strip('-')[:48].rstrip('-')
        name = f'{args.issue}-{slug}'
        branch = filled(args.branch if args.adopt else args.branch or f'task/{name}', 'branch')
        git(project, 'check-ref-format', '--branch', branch)
        if args.adopt:
            require(args.worktree, 'missing worktree for --adopt')
            git(project, 'show-ref', '--verify', f'refs/heads/{branch}')
        else:
            require(not git(project, 'branch', '--list', branch), 'branch exists; use --adopt or recorded lane continuation')
        wt = (args.worktree or project / '.claude/worktrees' / name).resolve()
        filled(str(wt), 'worktree')
        lane = dict(kind='lane', lane_id=f'{args.issue}-{time.time_ns()}', issue=args.issue, repo=repo,
                    branch=branch, worktree=str(wt), base=base, base_sha=base_sha)
        if args.adopt:
            lane_check(project, lane)
        else:
            require(not wt.exists(), 'worktree path already exists')
            if wt.is_relative_to(project):
                git(project, 'check-ignore', '-q', str(wt))
    wt = Path(lane['worktree'])
    pr = None
    if args.pr is not None:
        require(args.pr > 0, 'PR must be positive')
        pr = json.loads(run('gh', 'pr', 'view', str(args.pr), '--repo', repo, '--json',
                            'number,url,state,mergedAt,headRefName,headRefOid', cwd=project))
        require(pr['headRefName'] == lane['branch'], 'PR branch differs from lane')
    if args.cleanup:
        require(not wt == project and not project.is_relative_to(wt), 'run cleanup from outside the lane worktree')
        require(args.discard or (pr and pr['state'] == 'MERGED' and pr['mergedAt']), 'cleanup requires a merged PR or explicit --discard')
        require(not git(wt, 'status', '--porcelain', '-uall'), 'dirty worktree; preserve and inventory its contents first')
        require(not git(wt, 'ls-files', '--others', '--ignored', '--exclude-standard'), 'ignored artifacts remain; inventory and remove or retain them first')
        head = git(wt, 'rev-parse', 'HEAD')
        if not args.discard:
            require(head == pr['headRefOid'], 'lane head differs from merged PR; preserve unpublished work')
        inventory = git(project, 'log', '--oneline', f"{lane['base']}..{lane['branch']}")
        print(f"Cleanup inventory: {lane['branch']} {wt}\n{inventory or '(no commits beyond base)'}", file=sys.stderr)
        ancestor = subprocess.run(['git', '-C', str(project), 'merge-base', '--is-ancestor', head, lane['base']], capture_output=True).returncode == 0
        require(ancestor or args.force_delete, 'branch requires -D; review inventory then pass --force-delete explicitly')
        scratch = Path(tempfile.mkdtemp(prefix='devstandard-cleanup-'))
        try:
            git(project, 'worktree', 'remove', str(wt))
            git(project, 'branch', '-D' if args.force_delete else '-d', lane['branch'])
            git(project, 'worktree', 'prune')
            record = dict(lane, kind='cleanup', status='cleaned')
            publish(project, repo, args.issue, record, scratch)
            print(json.dumps(record))
        finally:
            shutil.rmtree(scratch)
        return
    require(issue['state'] == 'OPEN', 'issue is closed')
    if args.adopt:
        lane.update(status='adopted', pr=pr['url'] if pr else None)
        with tempfile.TemporaryDirectory(prefix='devstandard-adopt-') as scratch:
            publish(project, repo, args.issue, lane, Path(scratch))
        print(json.dumps(lane, indent=2))
        return
    implementation = args.implementation or ('codex' if shutil.which('codex') else 'claude')
    require(not args.resume or implementation == 'claude', 'Codex continuations use fresh processes, not --resume')
    if args.continuing:
        require(args.brief, '--continue requires --brief')
        prior_prs = {r['pr'] for r in history if r.get('lane_id') == lane['lane_id'] and r.get('pr')}
        if pr:
            require(pr['state'] == 'OPEN', '--continue requires the existing open --pr')
            require(not prior_prs or prior_prs == {pr['url']}, 'continuation PR differs from recorded PR')
        else:
            require(not prior_prs, '--continue requires the existing open --pr for a delivered lane')
            delivered = json.loads(run('gh', 'pr', 'list', '--repo', repo, '--head', lane['branch'],
                                       '--state', 'all', '--json', 'number', cwd=project))
            require(not delivered, '--continue requires the existing open --pr for a delivered lane')
    extra = filled(args.brief.read_text(), 'brief') if args.brief else ''
    model, effort = standing() if implementation == 'codex' else ('opus', None)
    reviewer_identity = (f'Codex, {model} at {effort}, read-only' if implementation == 'codex'
                         else f'Claude subagent, {model}, read-only')
    if args.purpose == 'reviewer':
        require(args.packet, 'reviewer requires --packet with the complete caller-assembled contract')
        role = reviewer_role(args.packet.read_text(), reviewer_identity)
        if implementation == 'claude':
            role += pinned_evidence(wt, args.packet.read_text())
    else:
        role = (ROOT / 'reference/worker-brief.md').read_text()
        for key, value in {'ISSUE_LINK_OR_SPEC': issue['url'], 'DONE_CHECK': fields['done-check'],
                           'BRANCH': lane['branch'], 'WORKTREE_PATH': str(wt)}.items():
            role = role.replace('{' + key + '}', value)
    identity = f'Codex {model} {effort}' if implementation == 'codex' else f'Claude {model}'
    packet = f"\n\n# Task packet\nIssue: {issue['url']}\nGoal: {fields['goal']}\nBounds: {fields['bounds']}\nDone-check: {fields['done-check']}\nBranch: {lane['branch']}\nWorktree: {wt}\nNamed base: {lane['base']} ({lane['base_sha']})\nRole references resolve from: {ROOT}\n"
    if pr:
        packet += f"PR: {pr['url']}\n"
    if extra:
        packet += ('\n## Continuation brief\n' if args.continuing else '\n## Inputs and expected output\n') + extra + '\n'
    packet += f'\nExecutor: {identity}. Record language: English.\n'
    if args.purpose == 'worker':
        email = 'noreply@openai.com' if implementation == 'codex' else 'noreply@anthropic.com'
        packet += f'Commit trailer: Co-Authored-By: {identity} <{email}>\nReturn the PR and evidence to the caller; never merge.\n'
    else:
        packet += f'Reviewer identity: {reviewer_identity}. Return the whole verdict to the caller for publication.\n'
    if implementation == 'codex':
        for program in ('codex', 'setsid', 'nohup'):
            require(shutil.which(program), f'{program} is not installed')
    # All input and role validation is finished. From here onward writes are deliberate.
    scratch = Path(tempfile.mkdtemp(prefix=f'devstandard-{args.issue}-{args.purpose}-'))
    prompt = role + packet if implementation == 'codex' or args.purpose == 'reviewer' else packet
    (scratch / 'brief.txt').write_text(prompt)
    if not existing:
        git(project, 'worktree', 'add', '-b', lane['branch'], str(wt), lane['base'])
        publish(project, repo, args.issue, lane, scratch)
    record = dict(lane, kind='run', purpose=args.purpose, implementation=implementation,
                  model=model, effort=effort, brief=str(scratch / 'brief.txt'), pr=pr['url'] if pr else None)
    if implementation == 'claude':
        instruction = dict(subagent_type=f'devstandard:{args.purpose}', description=f"Issue {args.issue} {args.purpose}",
                           prompt=(f"Read {scratch / 'brief.txt'} IN FULL using Read before judging. "
                                   "It contains the complete current contract, packet, and pinned Git evidence. "
                                   "Return the whole verdict to the caller."
                                   if args.purpose == 'reviewer' else prompt), run_in_background=True)
        if args.resume:
            instruction['resume'] = args.resume
        path = scratch / 'agent-spawn.json'
        path.write_text(json.dumps(instruction, indent=2) + '\n')
        record.update(status='awaiting-agent-tool', instruction=str(path))
        record['notice'] = 'Not launched: caller must invoke the Claude Agent tool with agent-spawn.json, then record the returned native handle on the issue. A shell cannot invoke the session Agent tool.'
        publish(project, repo, args.issue, record, scratch)
    else:
        output, log, completion = [scratch / name for name in ('output.txt', 'process.log', 'exit-code')]
        command = [shutil.which('codex'), 'exec', '-m', model, '-c', f'model_reasoning_effort={effort}',
                   '-s', 'workspace-write' if args.purpose == 'worker' else 'read-only', '-C', str(wt)]
        if args.purpose == 'worker':
            command += ['-c', 'sandbox_workspace_write.network_access=true']  # fetch, push and gh need the network
            for flag in ('--git-common-dir', '--git-dir'):
                command += ['--add-dir', git(wt, 'rev-parse', '--path-format=absolute', flag)]
        command += ['-o', str(output), prompt]
        (scratch / 'command.json').write_text(json.dumps(command))
        with open(os.devnull) as stdin, log.open('w') as stdout:
            process = subprocess.Popen(['setsid', 'nohup', sys.executable, str(Path(__file__).resolve()),
                                        '--supervise', str(scratch)], cwd=scratch, stdin=stdin,
                                       stdout=stdout, stderr=subprocess.STDOUT)
        record.update(status='launched', pid=process.pid, output=str(output), log=str(log), completion=str(completion))
        try:
            publish(project, repo, args.issue, record, scratch)
        except Exception:
            process.terminate()  # Codex has not passed the publication gate.
            raise
        (scratch / 'launch').touch()
    print(json.dumps(record, indent=2))


if __name__ == '__main__':
    if len(sys.argv) == 3 and sys.argv[1] == '--supervise':
        sys.exit(supervisor(sys.argv[2]))
    try:
        main()
    except (Refusal, OSError, ValueError) as error:
        print(f'dispatch refused: {error}', file=sys.stderr)
        sys.exit(2)
