#!/usr/bin/env python3
"""Dispatch one DevStandard lane. Requires Python 3.9+, git, and gh on macOS or Linux."""
import argparse
from contextlib import contextmanager
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
import review_packet
from hard_edges import (codex_hook_config, api, base_advanced, round_check,
                        Refusal as GuardRefusal)

ROOT = Path(__file__).resolve().parents[1]
MARKER = '<!-- devstandard-dispatch-v1 -->'
NATIVE_IMPLEMENTATIONS = ('claude', 'codex-native')
LEGACY_LOST_ATTESTATION = 'Authoritative inspection of the originating host/environment found no executor or supervisor owned by this exact run.'
LOST_ATTESTATION = 'Caller attests that authoritative inspection of the originating host/environment found no executor or supervisor owned by this exact run; the dispatcher has not verified that inspection.'


class Refusal(Exception):
    pass


def require(condition, message):
    if not condition:
        raise Refusal(message)


def run(*args, cwd=None):
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    require(result.returncode == 0, f'{shlex.join(map(str, args))}: {result.stderr.strip()}')
    return result.stdout.strip()


def git(project, *args):
    return run('git', '-C', str(project), *args)


def resolved(path, what):
    """`Path.resolve()`, with a symlink loop refused here instead of raised past the handler.

    `resolve()` answers a loop by interpreter — `RuntimeError` through 3.12, the looping path
    itself from 3.13 — and neither script's top-level handler catches `RuntimeError`, so on the
    runners' 3.12 a looped lane artifact exited 1 with a traceback instead of refusing (#451).
    `os.stat` reports the loop as `ELOOP` on every version, so read it first. Only a loop is
    refused: `resolve()` is not strict, and a path that merely does not exist is still the
    caller's to interpret.
    """
    try:
        os.stat(path)
    except OSError as error:
        require(error.errno != errno.ELOOP, f'malformed {what}: symlink loop at {path}')
    return Path(path).resolve()


def same_path(one, other):
    """Whether two spellings name one filesystem object, which is what every check below means.

    `Path.resolve()` normalizes symlinks and `..` but never case, so a macOS checkout reached as
    `/Users/leon/Projects/x` was refused against git's own spelling of the same directory (#443).
    A path that cannot be stat'ed — a worktree already removed, say — falls back to the lexical
    comparison these sites used before, so no pair they once admitted is refused now (#447).
    """
    try:
        return os.path.samefile(one, other)
    except OSError:
        return Path(one).resolve() == Path(other).resolve()


def inside(child, ancestor):
    """Whether `child` is `ancestor` itself or lies under it, by identity rather than spelling.

    `Path.is_relative_to` compares text, so a lane recorded through another spelling of the same
    directory — a symlinked route, or the differing case `resolve()` never normalizes (#443) —
    read as outside the worktree cleanup was about to remove (#449).
    """
    child = Path(child)
    return any(same_path(path, ancestor) for path in (child, *child.parents))


def filled(value, name):
    require(value and value.strip(), f'missing {name}')
    require(not re.search(r'\{[A-Z_][A-Z_0-9]*\}|\{field\}|\b(?:TBD|TODO)\b', value),
            f'unresolved placeholder in {name}')
    return value.strip()


def route_setting(purpose, implementation, model=None, effort=None):
    """The role's anchored row on the page fixes both knobs; each explicit field wins independently.

    A row this cannot find or parse is the page's defect, and CI enforces its cell form. Here it
    only warns and falls back to whatever the caller stated explicitly; the refusal is reserved for
    the knob nothing supplied, which is the one thing a dispatch cannot invent (#436).
    """
    page = ROOT / 'reference/orchestrator.md'
    try:
        text = page.read_text()
    except OSError:
        text = ''
    rows = [[cell.strip() for cell in line.split('|')[1:-1]]
            for line in text.splitlines() if line.startswith('|')]
    matches = [row for row in rows if row and row[0] == purpose]
    codex = implementation in ('codex', 'codex-native')
    match = (re.fullmatch(r'`([^`]+)` at `([^`]+)`', matches[0][1 if codex else 2])
             if len(matches) == 1 and len(matches[0]) == 3 else None)
    if match is None:
        print(f'dispatch warning: no readable anchored {purpose} row in {page}; '
              'using the explicit --model/--effort instead', file=sys.stderr)
    model = model if model is not None else (match[1] if match else None)
    effort = effort if effort is not None else (match[2] if match else None)
    require(model and effort, f'no readable anchored {purpose} row in {page}, and no explicit '
            '--model and --effort to use instead')
    return filled(model, 'model'), filled(effort, 'effort')


def mcp_tool_admission(binary):
    """Let a dispatched Codex CLI child actually call the MCP servers its host has attached.

    `codex exec` is non-interactive, so its approval policy is `never`, and `never` auto-rejects
    every MCP tool call: the child sees the tools, is refused on the call, and cannot tell that
    apart from an unreachable server. Measured on codex-cli 0.153.4 (issue #358): `exec` ignores
    every `approval_policy` value, no server-independent configuration field exists, and
    `--approve-for-me` — the one server-independent route — cannot be combined with `-s`, so it
    would cost the per-role OS sandbox that `reference/orchestrator.md` builds the gating
    reviewer on. `--dangerously-bypass-approvals-and-sandbox` would cost the same thing. What is
    left is the per-server key, which composes with both sandbox modes.

    The CLI enumerates the servers, so no host configuration file is read or edited, and a dotted
    override merges into the host's table rather than replacing it, so no server definition is
    lost. Returns the admitted names and, when something was not admitted, the notice that says so
    on the issue — a child whose MCP calls will be refused must not look like one whose servers
    are merely down.
    """
    try:
        listing = subprocess.run([binary, 'mcp', 'list', '--json'], capture_output=True,
                                 text=True, timeout=60)
        rows = json.loads(listing.stdout or '[]') if listing.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        rows = None
    if rows is None or not isinstance(rows, list):
        return [], ('MCP servers could not be enumerated (`codex mcp list --json` did not return a '
                    'listing), so this child admits no MCP tool call: a tool it can see but cannot '
                    'call is a harness limit to return, never an outage to work around '
                    '(`reference/worker.md`).')
    names = sorted({row['name'] for row in rows if isinstance(row, dict)
                    and row.get('name') and row.get('enabled', True)})
    # A dotted `-c` path keeps quote characters inside a segment, so a name needing quoting
    # cannot be addressed this way. Name it rather than leaving a silently refused tool.
    admitted = [name for name in names if re.fullmatch(r'[A-Za-z0-9_-]+', name)]
    unaddressable = [name for name in names if name not in admitted]
    return admitted, (('MCP servers whose names a dotted -c override cannot address, left '
                       'unadmitted: ' + ', '.join(unaddressable) + '. Their tool calls are refused '
                       'by policy rather than by an outage, which is a harness limit to return '
                       '(`reference/worker.md`).') if unaddressable else None)


CODEX_WORKER_MECHANICS = ('<!-- BEGIN CODEX WORKER MECHANICS -->\n',
                          '<!-- END CODEX WORKER MECHANICS -->\n')


def codex_worker_mechanics():
    """The Codex harness section a dispatched Codex worker is delivered with its role page.

    `reference/worker.md` is the shared contract every executor gets; the mechanics of recovering a
    binding, of spawning, and of the sandbox differ per harness, so each family reads its own page
    and never the other's (ADR 0061). A Claude worker receives `reference/harness-claude.md`
    through the agent definition body, which the harness loads as its system prompt. Codex has no
    such carrier — a native child gets SubagentStart and a CLI child has `DEVSTANDARD_ROLE` set, so
    neither is delivered `reference/harness-codex.md` at session start — which is why the brief
    carries this section for `codex` and `codex-native` instead.

    Only the marked worker-facing section travels. The rest of that page is host-facing: it tells
    an orchestrator how to dispatch, and a worker must not read it as its own instruction.
    """
    page = (ROOT / 'reference/harness-codex.md').read_text()
    begin, end = CODEX_WORKER_MECHANICS
    require(page.count(begin) == 1 and page.count(end) == 1,
            'reference/harness-codex.md must mark exactly one worker-facing section')
    block = page.split(begin, 1)[1].split(end, 1)[0].strip('\n')
    require(block, 'the marked Codex worker-facing section is empty')
    return '\n' + block + '\n'


def reviewer_role(value, identity):
    structured = review_packet.decode(value)
    require(structured is not None, 'reviewer requires structured contract slots; use scripts/review-packet assemble')
    return review_packet.render(structured, identity)


def pinned_evidence(project, packet):
    structured = review_packet.decode(packet)
    require(structured is not None, 'reviewer requires structured contract slots')
    slots = review_packet.validate(structured, "selected by dispatcher")
    base, head, convention = (slots[key] for key in ('REVIEW_BASE_SHA', 'HEAD_SHA', 'CONVENTION_BASE_SHA'))
    for name, sha, kind in [('review base', base, 'tree'), ('head', head, 'commit'),
                            ('convention base', convention, 'tree')]:
        require(re.fullmatch(r'(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})', sha), f'{name} must be a full SHA')
        git(project, 'rev-parse', '--verify', f'{sha}^{{{kind}}}')
    evidence = []

    def capture(*args, absent=False):
        command = ['git', '-C', str(project), *args]
        result = subprocess.run(command, text=True, capture_output=True)
        require(result.returncode == 0 or absent,
                f'{shlex.join(command)}: {result.stderr.strip()}')
        evidence.append(dict(command=shlex.join(command), exit_code=result.returncode,
                             stdout=chunks(result.stdout), stderr=chunks(result.stderr)))

    def chunks(text):
        return [line[i:i+1000] for line in text.splitlines(keepends=True)
                for i in range(0, len(line), 1000)]

    for options in [('--name-status',), ('--stat',), ()]:
        capture('diff', '--no-ext-diff', '--no-textconv', '--no-color', *options, base, head)
    # Include both sides of renames and all extensions: documentation is semantic, not a suffix.
    paths = git(project, 'diff', '--name-status', '--no-renames', '-z', base, head).split('\0')[1::2]
    for path in filter(None, paths):
        absent = not git(project, 'ls-tree', '-z', convention, '--', ':(literal)' + path)
        # A new path legitimately has no base blob; retain git show's failure as evidence of absence.
        capture('show', f'{convention}:{path}', absent=absent)
    return '\n\n## Pinned Git evidence\n' + json.dumps(evidence, ensure_ascii=False, indent=2) + '\n'


def records(comments):
    result = []
    for comment in comments:
        body = comment['body']
        if body.startswith(MARKER):
            match = re.search(r'```json\n(.*?)\n```', body, re.S)
            require(match, 'malformed dispatcher lane record on issue')
            result.append(json.loads(match.group(1)))
    return result


def worker_issue(issue):
    """Render the freshly fetched issue while omitting only dispatcher machine records."""
    parts = [f"Issue body (verbatim):\n----- BEGIN ISSUE BODY -----\n{issue['body']}\n"
             "----- END ISSUE BODY -----"]
    for comment in issue['comments']:
        if records([comment]):
            continue
        identity = comment.get('user') or comment.get('author') or {}
        # Render whatever GitHub returned. A comment whose shape surprises us is still the
        # human's instruction, and dropping the lane over its metadata helps nobody (#427).
        author = identity.get('login') or 'unknown author'
        created = comment.get('created_at') or comment.get('createdAt') or 'unknown date'
        parts.append(f"Issue comment by {author} on {created} (verbatim):\n"
                     f"----- BEGIN ISSUE COMMENT -----\n{comment['body']}\n"
                     "----- END ISSUE COMMENT -----")
    return '\n\n'.join(parts)


def publish(project, repo, issue, record, scratch):
    path = scratch / 'comment.md'
    path.write_text(MARKER + '\nDispatcher lane observation (process exit is not task acceptance).\n```json\n'
                    + json.dumps(record, indent=2) + '\n```\n')
    return run('gh', 'issue', 'comment', str(issue), '--repo', repo, '--body-file', str(path), cwd=project)


def artifact(record, key, name):
    brief = Path(record.get('brief', ''))
    require(brief.is_absolute() and brief.name == 'brief.txt', 'malformed run brief identity')
    value = record.get(key)
    if value is None:
        return None  # Legacy/missing metadata is unknown, never inferred completion.
    path = Path(value)
    require(path == brief.parent / name and
            resolved(path, key) == resolved(brief.parent, 'run scratch') / name,
            f'malformed {key}: must name {name} in the exact run scratch')
    return path


def completion_exit(record):
    path = artifact(record, 'completion', 'exit-code')
    if path is None:
        return None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    with os.fdopen(fd) as stream:
        require(stat.S_ISREG(os.fstat(stream.fileno()).st_mode), 'malformed completion marker')
        text = stream.read(64)
    require(re.fullmatch(r'-?\d+\n?', text) and -255 <= int(text) <= 255,
            'malformed completion marker; preserve evidence and reconcile the run')
    return int(text)


@contextmanager
def supervisor_lock(record):
    """Open only the recorded existing lock; a missing file has no serialization authority."""
    path = artifact(record, 'supervisor_lock', 'supervisor.lock')
    stream = None
    if path is not None:
        try:
            fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK)
        except FileNotFoundError:
            pass
        else:
            stream = os.fdopen(fd, 'r+')
    try:
        if stream is not None:
            require(stat.S_ISREG(os.fstat(stream.fileno()).st_mode), 'malformed supervisor lock')
            try:
                fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                yield True
                return
        yield False
    finally:
        if stream is not None:
            stream.close()


def reconciled(record):
    if record.get('status') != 'reconciled-lost':
        return False
    data = record.get('reconciliation', {})
    require(data.get('ownership_attestation') in (LOST_ATTESTATION, LEGACY_LOST_ATTESTATION)
            and data.get('reason') and data.get('evidence'),
            'malformed lost-run reconciliation')
    return True


def alive(record):
    require(record.get('implementation') in ('codex', 'claude-cli'), 'unknown executor implementation')
    if reconciled(record) or completion_exit(record) is not None:
        return False
    with supervisor_lock(record) as held:
        if completion_exit(record) is not None:
            return False
        require(held, 'recorded CLI execution lost or unknown; inspect the originating host and use --reconcile-lost')
        return True


def wait_process(process, record):
    """Wait only on our own Popen; never signal a PID recovered from an issue receipt."""
    def cancel(signum, frame):
        # A reaped child no longer owns its numeric PID/group; it may already be reused.
        if process.poll() is None:
            try:
                os.killpg(process.pid, signum)
                process.wait(timeout=3)
            except ProcessLookupError:
                pass
            except subprocess.TimeoutExpired:
                if process.poll() is None:
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                process.wait(timeout=3)
        raise Refusal('wait cancelled; inspect retained output and completion, or reconcile lost execution')

    handlers = {sig: signal.signal(sig, cancel) for sig in (signal.SIGINT, signal.SIGTERM)}
    try:
        process.wait()
        code = completion_exit(record)
        require(code is not None, 'executor completion is lost or unknown; retained receipt requires reconciliation')
        return code
    finally:
        for sig, handler in handlers.items():
            signal.signal(sig, handler)


def issue_comments(project, repo, issue):
    # gh issue view exposes GraphQL node IDs; only REST numeric IDs can PATCH comments.
    raw = run('gh', 'api', f'repos/{repo}/issues/{issue}/comments?per_page=100',
              '--paginate', cwd=project)
    decoder, rows = json.JSONDecoder(), []
    while raw.strip():
        page, end = decoder.raw_decode(raw.lstrip())
        rows.extend(page)
        raw = raw.lstrip()[end:]
    return rows


def issue_view(project, repo, issue):
    data = json.loads(run('gh', 'issue', 'view', str(issue), '--repo', repo,
                         '--json', 'number,title,url,body,state', cwd=project))
    data['comments'] = issue_comments(project, repo, issue)
    return data


def exact_run(issue, brief):
    history = records(issue['comments'])
    lanes = [r for r in history if r.get('kind') == 'lane']
    require(lanes, 'no current recorded lane')
    lane = lanes[-1]
    require(not any(r.get('status') == 'cleaned' and r.get('lane_id') == lane['lane_id'] for r in history),
            'lane already cleaned')
    matches = [(row, r) for row in issue['comments'] for r in records([row])
               if r.get('kind') == 'run' and r.get('brief') == brief]
    require(len(matches) == 1, 'reconciliation requires exactly one exact recorded run brief')
    row, record = matches[0]
    require(record.get('implementation') in ('codex', 'claude-cli'), 'reconciliation is only for CLI runs')
    require(all(record.get(k) == lane.get(k) for k in
                ('lane_id', 'issue', 'repo', 'branch', 'worktree', 'base', 'base_sha')),
            'run differs from current recorded lane')
    return row['id'], record, lane


def reconcile_lost(args, project, repo, issue):
    """Record the caller's lost-run finding on the exact run comment.

    Two things here stop a second writer, and they are what this keeps: a supervisor still holding
    the run's lock, and a completion marker present before or appearing during the reconciliation.
    Re-comparing record fields, demanding a URL-shaped evidence string, or insisting on a
    particular recorded status decided neither, so an operator's reading decides them now (#436).
    """
    _, original, lane = exact_run(issue, args.reconcile_lost)
    lane_check(project, lane)
    data = dict(reason=filled(args.reason, 'reconciliation reason'),
                evidence=filled(args.evidence, 'reconciliation evidence'),
                ownership_attestation=LOST_ATTESTATION)
    with supervisor_lock(original) as held:
        require(not held, 'recorded supervisor still running; reconciliation refused')
        require(completion_exit(original) is None, 'valid completion exists; use normal completion handling')
        cid, latest, _ = exact_run(issue_view(project, repo, args.issue), args.reconcile_lost)
        require(completion_exit(latest) is None, 'completion appeared during reconciliation; use normal completion handling')
        result = dict(latest, status='reconciled-lost', reconciliation=data)
        body = MARKER + '\nLost execution reconciled; no executor exit or task acceptance is claimed.\n```json\n' + json.dumps(result, indent=2) + '\n```\n'
        with tempfile.NamedTemporaryFile(mode='w', suffix='.json') as payload:
            json.dump({'body':body},payload); payload.flush()
            require(completion_exit(latest) is None, 'completion appeared during reconciliation; use normal completion handling')
            run('gh','api',f'repos/{repo}/issues/comments/{cid}','--method','PATCH','--input',payload.name,cwd=project)
        return result


def lane_check(project, lane):
    """Bound where a later `worktree remove` and `branch -D` would land: this repository, and a
    linked worktree rather than its main checkout. Whether the recorded path is the worktree root
    and which branch it currently holds are the operator's to read off the lane record (#436)."""
    wt = Path(lane['worktree'])
    require(same_path(git(wt, 'rev-parse', '--path-format=absolute', '--git-common-dir'),
                      git(project, 'rev-parse', '--path-format=absolute', '--git-common-dir')),
            'recorded lane belongs to another repository')
    require(not same_path(git(wt, 'rev-parse', '--path-format=absolute', '--git-dir'),
                          git(wt, 'rev-parse', '--path-format=absolute', '--git-common-dir')),
            'recorded lane is not a linked worktree')


def supervisor(scratch, lock_fd):
    """Own the inherited lock until a real CLI return is atomically recorded."""
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    os.set_inheritable(lock_fd, False)  # The CLI cannot keep our ownership lock alive.
    scratch = Path(scratch)
    child = None
    cancelled = False

    def cancel(signum, frame):
        nonlocal cancelled
        cancelled = True
        if child is not None and child.poll() is None:
            child.send_signal(signum)

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, cancel)
    try:
        deadline = time.monotonic() + 60
        while not (scratch / 'launch').exists():
            require(not cancelled and time.monotonic() < deadline,
                    'lane publication did not complete; executor was not launched')
            time.sleep(.05)
        require(not cancelled, 'launch cancelled before executor start')
        command = json.loads((scratch / 'command.json').read_text())
        if isinstance(command, dict):
            with open(command['stdin']) as stdin, open(command['stdout'], 'w') as stdout:
                child = subprocess.Popen(command['argv'], cwd=command['cwd'], stdin=stdin, stdout=stdout)
        else:
            with open(os.devnull) as stdin:
                child = subprocess.Popen(command, stdin=stdin)
        # A signal arriving during Popen must not leave the just-created child running.
        if cancelled:
            child.terminate()
        code = child.wait()
        tmp = scratch / 'exit-code.tmp'
        tmp.write_text(str(code) + '\n')
        tmp.replace(scratch / 'exit-code')
        return code
    except Exception as error:
        print(f'dispatch supervisor: {error}', flush=True)
        return 125  # No observed child return means no fabricated completion marker.
    finally:
        os.close(lock_fd)


DISPATCH_EPILOG = """LANE AND EXECUTOR CONTRACT (the caller-facing detail reference/orchestrator.md
points here for; that page keeps the decision and the command line).

  Flags. --project selects another target checkout. --adopt records an already matching --branch
  and --worktree without launching or creating one. --pr must name the lane's branch; without it
  a continuation takes the branch's single open PR, and reports a closed or ambiguous one in the
  run record rather than refusing.

  Continuation admission. An accepted head continues only on a recorded orchestrator ruling,
  except where the PR's base is no longer the default branch's head: that rebase continuation is
  admitted on the acceptance itself, consumes no review round, and is recorded as
  continuation=rebase. `guard merge --old-base/--old-head` then proves the rebased head.

  The packet. Dispatch supplies the task, authorized scope, acceptance criteria, identified
  changes, accessible evidence, the current role source, and every non-dispatch issue comment in
  order.

  CLI run state. This is the only liveness the dispatcher observes: a native handle is the
  caller's, and the handle recorded on the issue is its evidence. The supervisor's atomic
  completion marker establishes an observed exit. PIDs are diagnostic; a held supervisor_lock
  means running; an absent marker with a free or missing lock means lost or unknown, never done.
  Retain the run directory, brief identity, lock, output, log and marker through lane cleanup.
  Process exit and prose claims establish neither the PR nor its evidence -- read the output.

  --reconcile-lost preconditions. Originating-host inspection proving that this exact supervisor
  and executor stopped, plus --reason and --evidence, recorded verbatim, carrying that inspection
  and its result where they stay readable. It resolves one CLI run without inventing an exit or
  output; where inspection is unavailable, remain blocked. What the dispatcher itself still
  refuses is a held supervisor lock or a completion marker, before or during reconciliation: a
  live or uncertain executor never permits a second writer or cleanup. Re-running it overwrites
  the same comment, so state the finding you want recorded.

  Native receipts. native-spawn.json (--implementation codex-native) carries the full message, the
  fresh-conversation duty, the worktree, explicit model and effort, the absolute brief and its
  SHA-256; --implementation claude prepares the equivalent Agent-tool instruction. The caller
  passes the complete message to the native tool with no forked history, records the returned
  handle, and waits natively. A prepared receipt is not a running worker.
"""


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=DISPATCH_EPILOG,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('issue', type=int)
    parser.add_argument('--purpose', choices=['worker', 'reviewer'])
    parser.add_argument('--implementation', choices=['codex', 'claude', 'codex-native', 'claude-cli'],
                        help='codex: CLI process; claude: native Claude Agent; codex-native: native Codex worker; claude-cli: Claude CLI worker')
    parser.add_argument('--model', help="explicit model override; otherwise use the role's anchored row")
    parser.add_argument('--effort', help="explicit effort override; otherwise use the role's anchored setting")
    parser.add_argument('--project', type=Path, default=Path.cwd(), help='target checkout, distinct from plugin installation')
    parser.add_argument('--base', help='required named ref for a new lane, normally origin/main; fetch first')
    parser.add_argument('--branch', help='default task/ISSUE-TITLE; existing branch requires --adopt')
    parser.add_argument('--worktree', type=Path, help='default PROJECT/.claude/worktrees/ISSUE-TITLE')
    parser.add_argument('--packet', type=Path, help='complete caller-assembled reviewer contract and packet')
    parser.add_argument('--brief', type=Path, help='worker inputs/output detail or required continuation brief')
    parser.add_argument('--continue', dest='continuing', action='store_true')
    parser.add_argument('--adopt', action='store_true', help='record an existing --branch and --worktree with --base; does not launch')
    parser.add_argument('--pr', type=int, help="existing lane PR on the lane's branch (required for merged cleanup)")
    parser.add_argument('--resume', help='native worker handle to resume (Claude Agent handle, or a Codex native agent id or canonical task name); reviewers are always fresh')
    parser.add_argument('--reconcile-lost', help='exact recorded brief path; attest authoritative absence of all owned processes')
    parser.add_argument('--reason', help='reason for explicit lost-run reconciliation')
    parser.add_argument('--evidence', help='where the originating-host ownership and absence inspection is readable; recorded verbatim')
    parser.add_argument('--wait', action='store_true', help='CLI only: retain this invocation through observed executor completion')
    parser.add_argument('--cleanup', action='store_true')
    parser.add_argument('--discard', action='store_true', help='explicit caller instruction to discard this lane instead of merge')
    args = parser.parse_args()
    require(args.issue > 0, 'issue must be positive')
    require(not args.wait or (args.implementation in ('codex', 'claude-cli')
            and not any((args.adopt, args.cleanup, args.reconcile_lost))), '--wait requires CLI dispatch, not native or maintenance actions')
    require(not (args.implementation == 'codex-native' and args.purpose == 'reviewer'),
            'native Codex reviewers inherit host permissions; an enforced read-only gating review requires --implementation codex')
    require(not (args.implementation == 'claude-cli' and args.purpose == 'reviewer'),
            'Claude CLI does not provide an enforced read-only reviewer sandbox; use --implementation codex')
    require(not args.reconcile_lost or not any((args.purpose, args.implementation, args.base, args.branch,
            args.worktree, args.packet, args.brief, args.continuing, args.adopt, args.pr, args.resume,
            args.cleanup, args.discard, args.wait, args.model, args.effort)),
            '--reconcile-lost is a standalone maintenance action')
    require(not (args.model is not None or args.effort is not None) or not any(
            (args.adopt, args.cleanup, args.reconcile_lost)), '--model and --effort require executor dispatch')
    require(args.reconcile_lost or not (args.reason or args.evidence), '--reason and --evidence require --reconcile-lost')
    project = args.project.resolve()
    require(same_path(git(project, 'rev-parse', '--show-toplevel'), project), '--project must be a checkout root')
    repo = run('gh', 'repo', 'view', '--json', 'nameWithOwner', '--jq', '.nameWithOwner', cwd=project)
    issue = issue_view(project, repo, args.issue)
    if args.reconcile_lost:
        issue['comments'] = issue_comments(project, repo, args.issue)
        print(json.dumps(reconcile_lost(args, project, repo, issue), indent=2))
        return
    # The reviewer's contract slots are filled from these sections, so the parse IS their
    # validation. A worker's packet carries the issue body verbatim and reads no section, so the
    # same parse only refused lanes over their prose (#427).
    if args.purpose == 'reviewer':
        review_packet.issue_contract(issue['body'])
    # No files, branches, comments, or processes before this gate.
    history = records(issue['comments'])
    lanes = [r for r in history if r.get('kind') == 'lane']
    lane = lanes[-1] if lanes else None
    existing = args.cleanup or args.continuing or args.purpose == 'reviewer'
    require(args.cleanup or args.adopt or args.purpose, '--purpose is required')
    require(not args.adopt or not any((args.cleanup, args.continuing, args.purpose, args.implementation,
                                      args.packet, args.brief, args.resume)),
            '--adopt records only; run dispatch, continuation, or cleanup separately')
    require(not args.packet or args.purpose == 'reviewer', '--packet is for reviewers; workers use --brief')
    require(not args.discard or args.cleanup, '--discard requires --cleanup')
    require(not args.resume or (args.continuing and args.purpose == 'worker'), '--resume is for continuing workers only')
    if existing:
        require(lane, 'no recorded lane; dispatch a worker or --adopt an existing lane first')
        require(not any(r.get('status') == 'cleaned' and r.get('lane_id') == lane['lane_id'] for r in history), 'lane already cleaned')
        for key, value in [('branch', args.branch), ('worktree', args.worktree), ('base', args.base)]:
            require(value is None or (same_path(value, lane[key]) if key == 'worktree' else value == lane[key]),
                    f'{key} differs from recorded lane')
        lane_check(project, lane)
        runs = [r for r in history if r.get('kind') == 'run' and r.get('lane_id') == lane['lane_id']]
        for previous in runs:
            # A native handle is the caller's own: nothing here can observe it, so the
            # orchestrator's record on the issue is its evidence and an attestation flag would
            # only restate it (#427). The CLI check below is the one that keeps a second writer
            # off a running lane.
            if previous.get('implementation') in NATIVE_IMPLEMENTATIONS:
                continue
            require(not alive(previous), 'recorded executor still running; wait for completion')
    else:
        require(not lane or any(r.get('status') == 'cleaned' and r.get('lane_id') == lane['lane_id'] for r in history),
                'lane exists; use --continue')
        base = filled(args.base, 'base')
        require(base != 'HEAD' and not base.startswith('-') and not re.fullmatch(r'[0-9a-fA-F]{40,64}', base), 'base must be a named ref')
        require(git(project, 'rev-parse', '--symbolic-full-name', base).startswith('refs/'), 'base must be a named ref')
        base_sha = git(project, 'rev-parse', '--verify', base + '^{commit}')
        slug = re.sub('[^a-z0-9]+', '-', issue['title'].lower()).strip('-')[:48].rstrip('-')
        name = f'{args.issue}-{slug}'
        branch = filled(args.branch if args.adopt else args.branch or f'task/{name}', 'branch')
        # An unusable branch name, an existing branch and an occupied worktree path are errors
        # `git worktree add -b` raises itself further down, in its own words (#427).
        if args.adopt:
            require(args.worktree, 'missing worktree for --adopt')
            git(project, 'show-ref', '--verify', f'refs/heads/{branch}')
        wt = (args.worktree or project / '.claude/worktrees' / name).resolve()
        filled(str(wt), 'worktree')
        lane = dict(kind='lane', lane_id=f'{args.issue}-{time.time_ns()}', issue=args.issue, repo=repo,
                    branch=branch, worktree=str(wt), base=base, base_sha=base_sha)
        if args.adopt:
            lane_check(project, lane)
        elif inside(wt, project):
            git(project, 'check-ignore', '-q', str(wt))
    wt = Path(lane['worktree'])
    pr = None
    pr_note = None
    if args.pr is not None:
        require(args.pr > 0, 'PR must be positive')
        pr = json.loads(run('gh', 'pr', 'view', str(args.pr), '--repo', repo, '--json',
                            'number,url,state,mergedAt,baseRefName,headRefName,headRefOid', cwd=project))
        require(pr['headRefName'] == lane['branch'], 'PR branch differs from lane')
    if args.cleanup:
        require(not inside(project, wt), 'run cleanup from outside the lane worktree')
        require(args.discard or (pr and pr['state'] == 'MERGED' and pr['mergedAt']), 'cleanup requires a merged PR or explicit --discard')
        require(not git(wt, 'status', '--porcelain', '-uall'), 'dirty worktree; preserve and inventory its contents first')
        require(not git(wt, 'ls-files', '--others', '--ignored', '--exclude-standard'), 'ignored artifacts remain; inventory and remove or retain them first')
        head = git(wt, 'rev-parse', 'HEAD')
        if not args.discard:
            require(head == pr['headRefOid'], 'lane head differs from merged PR; preserve unpublished work')
        inventory = git(project, 'log', '--oneline', f"{lane['base']}..{lane['branch']}")
        print(f"Cleanup inventory: {lane['branch']} {wt}\n{inventory or '(no commits beyond base)'}", file=sys.stderr)
        # Squash and rebase integration always leave the lane head off the base, so `-d` would
        # always refuse and its authorization was always granted: a predicate that is always true
        # stops nothing (#427). The checks that can actually lose work ran above.
        scratch = Path(tempfile.mkdtemp(prefix='devstandard-cleanup-'))
        try:
            git(project, 'worktree', 'remove', str(wt))
            git(project, 'branch', '-D', lane['branch'])
            git(project, 'worktree', 'prune')
            record = dict(lane, kind='cleanup', status='cleaned')
            publish(project, repo, args.issue, record, scratch)
            print(json.dumps(record))
        finally:
            shutil.rmtree(scratch)
        return
    if args.adopt:
        lane.update(status='adopted', pr=pr['url'] if pr else None)
        with tempfile.TemporaryDirectory(prefix='devstandard-adopt-') as scratch:
            publish(project, repo, args.issue, lane, Path(scratch))
        print(json.dumps(lane, indent=2))
        return
    implementation = args.implementation or 'claude'  # the host's own subagent (#332)
    require(not args.resume or implementation in NATIVE_IMPLEMENTATIONS, '--resume is only for native workers; CLI executors start fresh')
    if args.continuing:
        require(args.brief, '--continue requires --brief')
        # A delivered lane continues through its open PR; without one, the dispatcher says so on
        # the issue and continues on the lane branch. Refusing here stranded #362's lane twice
        # (#371/#372), and the lane branch — not the PR — is what a continuation actually needs.
        if not pr:
            rows = json.loads(run('gh', 'pr', 'list', '--repo', repo, '--head', lane['branch'],
                                  '--state', 'all', '--json',
                                  'number,url,state,mergedAt,baseRefName,headRefName,headRefOid', cwd=project))
            open_prs = [row for row in rows if row['state'] == 'OPEN']
            if len(open_prs) == 1:
                pr = open_prs[0]
            elif open_prs:
                pr_note = ('more than one open PR on the lane branch ('
                           + ', '.join(f"#{row['number']}" for row in open_prs)
                           + '); none selected, continuing on the lane branch')
            elif rows:
                pr_note = ('no open PR on the lane branch ('
                           + ', '.join(f"#{row['number']} {row['state']}" for row in rows)
                           + '); continuing on the lane branch')
        if pr:
            # #372's replacement for the family above, and the one rule that stays: a PR on
            # another branch is another lane's, whatever its state.
            require(pr['headRefName'] == lane['branch'], 'PR branch differs from lane')
            if pr['state'] != 'OPEN':
                pr_note = f"named PR #{pr['number']} is {pr['state']}"
    # No placeholder search here: a brief legitimately quotes a Note, a template slot or an open
    # `TBD`, and refusing over its prose stranded #427's own first two dispatches (#436).
    extra = ''
    if args.brief:
        extra = args.brief.read_text().strip()
        require(extra, 'missing brief')
    model, effort = route_setting(args.purpose, implementation, args.model, args.effort)
    reviewer_identity = (f'Codex, {model} at {effort}, read-only' if implementation == 'codex'
                         else f'Claude subagent, {model} at {effort}, read-only')
    if args.purpose == 'reviewer':
        require(args.packet, 'reviewer requires --packet with the complete caller-assembled contract')
        role = reviewer_role(args.packet.read_text(), reviewer_identity)
        if implementation == 'claude':
            role += pinned_evidence(wt, args.packet.read_text())
    else:
        # One contract for every executor: the page carries no template slot, because the packet
        # already carries the issue, branch, worktree and done-check it used to duplicate, and a
        # static Claude agent definition cannot fill one (#402, ADR 0060). What differs per
        # executor is harness mechanics, and only Codex needs them carried here: the Claude
        # definition body already delivers `reference/harness-claude.md` on both Claude paths
        # (ADR 0061).
        role = (ROOT / 'reference/worker.md').read_text()
        if implementation in ('codex', 'codex-native'):
            role += codex_worker_mechanics()
    identity = f'Codex {model} {effort}' if implementation == 'codex' else f'Claude {model} {effort}'
    if implementation == 'codex-native':
        identity = f'Codex native subagent {model} {effort}'
    packet = f"\n\n# Task packet\nIssue: {issue['url']}\nBranch: {lane['branch']}\nWorktree: {wt}\nNamed base: {lane['base']} ({lane['base_sha']})\nRole references resolve from: {ROOT}\n\n{worker_issue(issue)}\n"
    if pr:
        packet += f"PR: {pr['url']}\n"
    if extra:
        packet += ('\n## Continuation brief\n' if args.continuing else '\n## Inputs and expected output\n') + extra + '\n'
    packet += f'\nExecutor: {identity}. Record language: English.\n'
    if args.purpose == 'worker':
        email = 'noreply@openai.com' if implementation in ('codex', 'codex-native') else 'noreply@anthropic.com'
        packet += f'Commit trailer: Co-Authored-By: {identity} <{email}>\nReturn the PR and evidence to the caller; never merge.\n'
        if implementation == 'claude-cli':
            packet += ('Permission policy: Claude acceptEdits with permission prompts disabled, under host permissions. '
                       'The assigned worktree is your scope; this CLI does not add an independent OS sandbox. '
                       'If a required action is denied, return the blocker; do not loosen permissions or bypass it.\n')
    else:
        packet += f'Reviewer identity: {reviewer_identity}. Return the whole verdict to the caller for publication.\n'
    if implementation == 'codex':
        require(shutil.which('codex'), 'codex is not installed')
    if implementation == 'claude-cli':
        require(shutil.which('claude'), 'claude is not installed')
        require((ROOT / '.claude-plugin/plugin.json').is_file(), 'Claude plugin manifest is missing')
        require((ROOT / 'hooks/hooks.json').is_file(), 'Claude plugin hooks are missing')
    if implementation in ('codex', 'claude-cli'):
        require((ROOT / 'hooks/pre-tool-use').is_file(), 'repository role hook is missing')
    rebase_continuation = False
    if args.purpose == 'worker' and args.continuing and pr:
        rows = api(f'repos/{repo}/issues/{pr["number"]}/comments?per_page=100', '--paginate')
        owner = api(f'repos/{repo}')['owner']['login']
        rows = [r for r in rows if r.get('user', {}).get('login') == owner]
        # Main moving under an accepted head admits the rebase continuation on the acceptance
        # itself: no ruling, and no review round (#421).
        rebase_continuation = round_check(
            rows, pr['headRefOid'],
            rebase=base_advanced(repo, pr['baseRefName'], pr['headRefOid']))['rebase']
    # All input and role validation is finished. From here onward writes are deliberate.
    scratch = Path(tempfile.mkdtemp(prefix=f'devstandard-{args.issue}-{args.purpose}-'))
    # The role rides the agent definition body on BOTH Claude paths — the default `claude`
    # subagent (#332) and `claude-cli`, which launches `--agent devstandard:worker` below — so
    # the brief carries the packet alone there and the page arrives exactly once (#411). It rides
    # the brief only where no definition can carry it: `codex` and `codex-native`, and a Claude
    # reviewer, whose judging contract is assembled per review rather than installed.
    # `--implementation claude-cli --purpose reviewer` is refused above; the purpose is named here
    # so this condition holds on its own terms.
    definition_carries_role = (implementation in ('claude', 'claude-cli')
                               and args.purpose == 'worker')
    prompt = packet if definition_carries_role else role + packet
    (scratch / 'brief.txt').write_text(prompt)
    if not existing:
        git(project, 'worktree', 'add', '-b', lane['branch'], str(wt), lane['base'])
        publish(project, repo, args.issue, lane, scratch)
    record = dict(lane, kind='run', purpose=args.purpose, implementation=implementation,
                  model=model, effort=effort, brief=str(scratch / 'brief.txt'), pr=pr['url'] if pr else None,
                  issue_state=issue['state'].lower())
    if pr_note:
        record['pr_note'] = pr_note
    if rebase_continuation:
        record['continuation'] = 'rebase'
    if implementation in NATIVE_IMPLEMENTATIONS:
        if implementation == 'claude':
            instruction = dict(subagent_type=f'devstandard:{args.purpose}', model=model, effort=effort,
                               description=f"Issue {args.issue} {args.purpose}",
                               prompt=(f"Read {scratch / 'brief.txt'} IN FULL using Read before judging. "
                                       "It contains the complete current contract, packet, and pinned Git evidence. "
                                       "Return the whole verdict to the caller."
                                       if args.purpose == 'reviewer' else prompt), run_in_background=True)
            if args.resume:
                instruction['resume'] = args.resume
            path = scratch / 'agent-spawn.json'
            notice = ('Not launched: agent-spawn.json records requested settings. Map supported controls to the Claude Agent tool, '
                      'then record its returned native handle on the issue. If the tool has no per-spawn effort control, '
                      'use the matching shipped-role default; a different requested effort is unsupported and must be reported, '
                      'never silently claimed as applied. A shell cannot invoke the session Agent tool.')
        else:
            brief_sha256 = hashlib.sha256(Path(record['brief']).read_bytes()).hexdigest()
            preamble = (f"Before any task work, read {record['brief']} IN FULL and verify its SHA-256 is "
                        f"{brief_sha256}. This saved file is authoritative over the inline copy below. "
                        "If it is missing, unreadable, incomplete, or its digest does not match, stop and "
                        "return blocked; do not proceed from the inline copy.\n\n")
            record['brief_sha256'] = brief_sha256
            delivery = (
                'Deliver the complete message as a follow-up to the recorded resume handle on the existing '
                'native child, which answers with its context intact: multi_agent_v1 uses send_input; '
                'collaboration uses followup_task. Do not spawn another child. '
                'This is a semantic instruction, not Claude Agent arguments or a subprocess command.'
                if args.resume else
                'Use the available native Codex subagent tool with the complete message and a fresh conversation: '
                'multi_agent_v1 uses fork_context=false; collaboration uses fork_turns="none". '
                'This is a semantic instruction, not Claude Agent arguments or a subprocess command.')
            settings_obligation = (
                'The resumed child keeps the model and reasoning_effort it was spawned with; neither follow-up '
                'tool carries those fields. If they differ from this receipt, report it; do not spawn a '
                'replacement child silently. Host permissions and developer instructions remain inherited.'
                if args.resume else
                'Pass model and reasoning_effort exactly as supplied to the native tool. If the host lacks either '
                'field or rejects these settings, report unsupported; do not substitute another model or effort. '
                'The child still inherits host permissions and developer instructions; a fresh conversation excludes parent conversation history.')
            handle_obligation = (
                'The resumed child keeps the recorded handle; a handle that is closed or whose spawning session '
                'has ended is lost, so dispatch a fresh executor instead of inventing one. Observe its return '
                'with the host-native wait tool. '
                if args.resume else
                'Record the returned actual native handle on the issue and observe its return with the host-native wait tool. ')
            instruction = dict(format='devstandard-codex-native-v1', message=preamble + prompt,
                               brief=record['brief'], brief_sha256=brief_sha256,
                               model=model, reasoning_effort=effort,
                               fresh_conversation=not args.resume, worktree=str(wt),
                               native_tool_obligations=[delivery, settings_obligation,
                'Use the assigned worktree explicitly for every command; native spawning can retain the host working directory.',
                handle_obligation.strip()])
            if args.resume:
                instruction['resume'] = args.resume
            path = scratch / 'native-spawn.json'
            notice = ('Not launched: caller must deliver the message in native-spawn.json as a follow-up to its '
                      'resume handle on the existing native child, which keeps its context, and wait natively. '
                      'Permissions and developer instructions are inherited from the host.'
                      if args.resume else
                      'Not launched: caller must invoke the host-native Codex subagent tool using the message, model and reasoning_effort in native-spawn.json with a fresh conversation, record its returned handle on the issue, and wait natively. Permissions and developer instructions are inherited from the host.')
        path.write_text(json.dumps(instruction, indent=2) + '\n')
        record.update(status='awaiting-agent-tool', instruction=str(path))
        record['notice'] = notice
        publish(project, repo, args.issue, record, scratch)
    else:
        output = scratch / ('output.jsonl' if implementation == 'claude-cli' else 'output.txt')
        log, completion = [scratch / name for name in ('process.log', 'exit-code')]
        if implementation == 'claude-cli':
            command = dict(argv=[shutil.which('claude'), '--print', '--plugin-dir', str(ROOT),
                '--agent', 'devstandard:worker', '--permission-mode', 'acceptEdits', '--permission-prompts', 'none',
                '--output-format', 'stream-json', '--verbose', '--no-session-persistence', '--model', model, '--effort', effort],
                cwd=str(wt), stdin=str(scratch / 'brief.txt'), stdout=str(output))
            record.update(permission_mode='acceptEdits', sandbox='host', output_format='stream-json',
                          notice='Claude CLI uses host/tool permissions, not an independent OS sandbox. Read all result events and their permission_denials in the raw JSONL output, including earlier results; the last result and process exit alone are not task acceptance. Return a required-action denial as blocked; never bypass it.')
        else:
            command = [shutil.which('codex'), 'exec', '-m', model, '-c', f'model_reasoning_effort={effort}',
                       '-s', 'workspace-write' if args.purpose == 'worker' else 'read-only', '-C', str(wt)]
            command += ['-c', 'features.hooks=true']
            for setting in codex_hook_config(ROOT, args.purpose).splitlines():
                command += ['-c', setting]
            # Only alongside the fixed role hook from this dispatcher's installation, checked
            # to exist above. Codex intends the flag for automation that already vets hook sources.
            command += ['--dangerously-bypass-hook-trust']
            if args.purpose == 'worker':
                command += ['-c', 'sandbox_workspace_write.network_access=true']  # fetch, push and gh need the network
                for flag in ('--git-common-dir', '--git-dir'):
                    command += ['--add-dir', git(wt, 'rev-parse', '--path-format=absolute', flag)]
            # Both purposes: the sandbox modes above are what bound a reviewer, not its tools.
            admitted, mcp_notice = mcp_tool_admission(command[0])
            for name in admitted:
                command += ['-c', f'mcp_servers.{name}.default_tools_approval_mode="approve"']
            record['mcp_servers'] = admitted
            if mcp_notice:
                record['notice'] = mcp_notice
            command += ['-o', str(output), prompt]
        (scratch / 'command.json').write_text(json.dumps(command))
        lock = scratch / 'supervisor.lock'
        with lock.open('x+') as ownership, open(os.devnull) as stdin, log.open('w') as stdout:
            fcntl.flock(ownership, fcntl.LOCK_EX)
            process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()),
                                        '--supervise', str(scratch), str(ownership.fileno())], cwd=scratch, stdin=stdin,
                                       pass_fds=(ownership.fileno(),),
                                       stdout=stdout, stderr=subprocess.STDOUT, start_new_session=True,
                                       env=dict(os.environ, DEVSTANDARD_ROLE=args.purpose))
        record.update(status='launched', pid=process.pid, output=str(output), log=str(log), completion=str(completion), supervisor_lock=str(lock))
        try:
            publish(project, repo, args.issue, record, scratch)
        except Exception:
            process.terminate()  # The CLI has not passed the publication gate.
            process.wait()
            raise
        (scratch / 'launch').touch()
        if args.wait:
            record['executor_exit'] = wait_process(process, record)
    print(json.dumps(record, indent=2))


if __name__ == '__main__':
    if len(sys.argv) == 4 and sys.argv[1] == '--supervise':
        sys.exit(supervisor(sys.argv[2], int(sys.argv[3])))
    try:
        main()
    except (Refusal, GuardRefusal, OSError, ValueError) as error:
        print(f'dispatch refused: {error}', file=sys.stderr)
        sys.exit(2)
